# Only the main application's build inputs belong in the Docker context.
**
!pom.xml
!mvnw
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!src/
!src/**

# Keep local metadata, build outputs and all Lambda modules out.
.git
.idea
.vscode
.agents
.codex
target
**/target
lambda/
lambda/*/target
**/*.iml
**/*.ipr
**/*.iws
**/.classpath
**/.project
**/.settings
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/*.log

# Never send local AWS credentials or secret files to the Docker daemon.
.aws
**/.aws
**/credentials
**/credentials.*
**/*credentials*
**/*secret*
**/*access_key*
**/*access-key*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
